+                          <td>{pretty(e.condition)}</td>
+                          <td className="mono">
+                            {e.issuedUnits}/{e.totalUnits}
+                          </td>
+                        </tr>
+                      ))}
+                    </tbody>
+                  </table>
+                </div>
+              )}
+            </div>
+          )}
+        </div>
+      )}
+    </>
+  );
+}
+
+function Mini({ label, value }) {
